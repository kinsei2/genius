body{
    margin:0;
    font-family:"Pretendard", sans-serif;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    background:linear-gradient(180deg,#AEE8FF 0%, #6BCBFF 45%, #2D9CDB 100%);
}

.container{
    text-align:center;
    background:rgba(255,255,255,0.15);
    backdrop-filter:blur(10px);
    padding:40px;
    border-radius:30px;
    box-shadow:0 10px 30px rgba(0,0,0,0.15);
}

button{
    width:200px;
    height:200px;
    border-radius:50%;
    border:8px solid #4FA8F7;
    background:white;
    color:#1F6FB2;
    font-size:34px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    transform:scale(1.05);
    box-shadow:0 0 25px rgba(79,168,247,.5);
}

button:active{
    background:#FF8A65;
    color:white;
}

#status{
    margin-top:25px;
    font-size:20px;
    color:white;
    font-weight:600;
}
